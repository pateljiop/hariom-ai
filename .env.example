# Never commit .env

# Core AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
AIRFORCE_API_KEY=

# Additional providers from your provider list
BAZAARLINK_API_KEY=
COHERE_API_KEY=
LLM7_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_API_KEY=
AIML_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=

# Provider base URLs (already set; normally you only need to add keys)
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
MISTRAL_BASE_URL=https://api.mistral.ai/v1
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1
AIRFORCE_BASE_URL=https://api.airforce/v1
COHERE_BASE_URL=https://api.cohere.com/compatibility/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
LLM7_BASE_URL=https://api.llm7.io/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
AIML_BASE_URL=https://api.aimlapi.com/v1
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Default models
OPENAI_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_SECOND_FALLBACK_MODEL=qwen/qwen3.8-27b
OPENROUTER_MODEL=openrouter/free
CEREBRAS_MODEL=gpt-oss-120b
MISTRAL_MODEL=devstral-small-latest
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
AIRFORCE_MODEL=gpt-4.1-mini
COHERE_MODEL=command-a-03-2025
DEEPSEEK_MODEL=deepseek-chat
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM7_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3.2
AIML_MODEL=gpt-4o-mini

# Router
HARIOM_ROUTER_COOLDOWN=60
HARIOM_ROUTER_RETRIES=2
HARIOM_ROUTER_TIMEOUT=90
HARIOM_CACHE_ENABLED=1
HARIOM_CACHE_TTL=300

HARIOM_GATEWAY_HOST=127.0.0.1
HARIOM_GATEWAY_PORT=8080
# Required when HARIOM_GATEWAY_HOST is not localhost.
HARIOM_GATEWAY_API_KEY=
